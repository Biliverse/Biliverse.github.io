[Script]
PreferencePanes = type=http-request, pattern=^https:\/\/biliverse\.github\.io\/(?:api\/Enhanced(?:\/[^?]*)?|settings\/Enhanced\/?)(?:\?.*)?$, requires-body=1, max-size=65536, script-path=https://biliverse.github.io/settings/assets/Enhanced.request.js?v=0.7.1

[MITM]
hostname = %APPEND% biliverse.github.io
