name: Biliverse PreferencePanes
desc: Enhanced 模块设置页与持久化读写；项目首页独立托管。
openUrl: https://biliverse.github.io/settings/
http:
  mitm:
    - biliverse.github.io
  script:
    - match: ^https:\/\/biliverse\.github\.io\/(?:api\/Enhanced(?:\/[^?]*)?|settings\/Enhanced\/?)(?:\?.*)?$
      name: PreferencePanes
      type: request
      require-body: true
script-providers:
  PreferencePanes:
    url: https://gist.githubusercontent.com/VirgilClyne/97d7611df1c0b29a254ce8f527137576/raw/settings.dev.bundle.js
    interval: 86400
